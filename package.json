{
  "name": "arkitekt",
  "displayName": "Arkitekt",
  "description": "Arkitekt in VS Code: your app's own `arkitekt check` underlined in the BSX of every blok (through arkitekt-lsp), plus highlighting, completion and hovers for BSX.",
  "version": "1.1.2",
  "publisher": "arkitekt-dev",
  "icon": "images/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:python"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "arkitekt-lsp imports your app to check it, so it starts only in a trusted workspace. Highlighting, and completion in .bsx files, work everywhere.",
      "restrictedConfigurations": [
        "arkitekt.lsp.path"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "bsx",
        "aliases": [
          "BSX",
          "bsx"
        ],
        "extensions": [
          ".bsx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bsx",
        "scopeName": "source.bsx",
        "path": "./syntaxes/bsx.tmLanguage.json"
      },
      {
        "scopeName": "bsx.injection.python.multi",
        "path": "./syntaxes/bsx-in-python-multi.tmLanguage.json",
        "injectTo": [
          "source.python"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.bsx": "bsx"
        }
      },
      {
        "scopeName": "bsx.injection.python.single",
        "path": "./syntaxes/bsx-in-python-single.tmLanguage.json",
        "injectTo": [
          "source.python"
        ],
        "embeddedLanguages": {
          "meta.embedded.line.bsx": "bsx"
        }
      }
    ],
    "commands": [
      {
        "command": "arkitekt.check",
        "title": "Check App",
        "category": "Arkitekt"
      },
      {
        "command": "arkitekt.restart",
        "title": "Restart Language Server",
        "category": "Arkitekt"
      },
      {
        "command": "arkitekt.showOutput",
        "title": "Show Language Server Output",
        "category": "Arkitekt"
      },
      {
        "command": "arkitekt.addDependency",
        "title": "Add a Dependency from the Server…",
        "category": "Arkitekt"
      },
      {
        "command": "arkitekt.chooseApp",
        "title": "Choose App…",
        "category": "Arkitekt"
      },
      {
        "command": "arkitekt.login",
        "title": "Connect to Server",
        "category": "Arkitekt"
      },
      {
        "command": "arkitekt.logout",
        "title": "Disconnect from Server",
        "category": "Arkitekt"
      },
      {
        "command": "arkitekt.rekuest.menu",
        "title": "Server…",
        "category": "Arkitekt"
      },
      {
        "command": "arkitekt.rekuest.refresh",
        "title": "Ask Rekuest Again",
        "category": "Arkitekt"
      }
    ],
    "configuration": {
      "title": "Arkitekt",
      "properties": {
        "arkitekt.check.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Run `arkitekt check` (through arkitekt-lsp) when a Python file of an app is saved."
        },
        "arkitekt.check.timeout": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "description": "Seconds a check may take before it is stopped. Importing an app imports its libraries, which can be slow."
        },
        "arkitekt.target": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "The app to check when the saved file is not itself one, as `arkitekt check` takes it (`app`, `pkg.main:api`, `app.py`), and which App to use in a file with several (`many.py:api`). `Arkitekt: Choose App…` sets it. Empty: the CLI's default (ARKITEKT_APP, else `app`)."
        },
        "arkitekt.server.connect": {
          "type": "boolean",
          "default": false,
          "description": "Also ask rekuest, with read-only access, who would satisfy each dependency your app declares: a count above each protocol, a warning when nobody does, the agents on hover. `Arkitekt: Connect to Server` turns this on and `Arkitekt: Disconnect from Server` turns it off. Off, the language server talks to nothing."
        },
        "arkitekt.server.url": {
          "type": "string",
          "default": "https://go.arkitekt.live",
          "description": "The coordination server `Arkitekt: Connect to Server` uses."
        },
        "arkitekt.lsp.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "The `arkitekt-lsp` executable. Empty: the workspace's .venv, then the Python extension's interpreter, then PATH. It must run in the app's environment: it imports the app to check it."
        }
      }
    }
  },
  "scripts": {
    "grammars": "node syntaxes/generate.mjs",
    "build": "node syntaxes/generate.mjs && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "package": "pnpm build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@arkitektio/bsx": "^2.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "22.19.1",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "0.27.7",
    "semantic-release": "^25.0.9",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkitektio/arkitekt-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/arkitektio/arkitekt-vscode/issues"
  },
  "homepage": "https://github.com/arkitektio/arkitekt-vscode#readme",
  "packageManager": "pnpm@12.11.2"
}
